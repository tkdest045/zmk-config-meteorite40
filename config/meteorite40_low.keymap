#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mt { 
    flavor = "tap-preferred"; // change hold to tap
    tapping-term-ms = <200>;
    quick-tap-ms = <150>; // change 200 to 150
};

&lt {
    flavor = "tap-preferred";
    tapping-term-ms = <150>; // change 200 to 150
    quick-tap-ms = <150>; // change 200 to 150
};

/ { 
    combos {
        compatible = "zmk,combos";

        esc {
            bindings = <&kp ESCAPE>;
            key-positions = <0 1>;
            layers = <0>;
        };

        caps {
            bindings = <&kp CAPS>;
            key-positions = <20 21>;
            layers = <0>;
        };

        tab {
            bindings = <&kp TAB>;
            key-positions = <10 11>;
            layers = <0>;
        };

        backspace {
            bindings = <&kp BSPC>;
            key-positions = <8 9>;
            layers = <0 3>;
        };

        delete {
            bindings = <&kp DEL>;
            key-positions = <5 6>;
            layers = <0 3>;
        };

        gui_space {
            bindings = <&kp LG(SPACE)>;
            key-positions = <35 36>;
            layers = <0>;
        };

        quote {
            bindings = <&kp SQT>;
            key-positions = <18 19>;
            layers = <0>;
        };

        boot_combo {
            bindings = <&bootloader>;
            key-positions = <20 31>;
            layers = <1 3>;
        };

    };

    keymap {
        compatible = "zmk,keymap";
        layout = &LOW_PROFILE_DEFAULT;

        win_default_layer {
            display-name = "BASE";
            bindings = <
                &kp Q        &kp W       &kp E        &kp R        &kp T                                 &kp Y        &kp U       &kp I       &kp O      &kp P
                &kp A        &kp S       &kp D        &kp F        &kp G                                 &kp H        &kp J       &kp K       &kp L      &kp SEMI
                &kp Z        &kp X       &kp C        &kp V        &kp B        &mkp MB1     &mkp MB2    &kp N        &kp M       &kp COMMA   &kp DOT    &kp SLASH
                                        &kp LCTRL  &kp LALT  &kp LGUI   &lt 1 SPACE  &lt 2 ENTER  &kp LSHIFT  &kp BSPC  &kp DEL
            >;
        };

        layer_1 {
            display-name = "ARROW";
            bindings = <
                &none      &kp HOME    &kp UP       &kp END    &none                           &none      &kp HOME    &kp UP       &kp END    &none
                &none      &kp LEFT    &kp DOWN     &kp RIGHT  &none                           &none      &kp LEFT    &kp DOWN     &kp RIGHT  &none
                &none      &none       &kp LC(DOWN) &none      &none     &mkp MB3   &none      &none      &none       &kp LC(DOWN) &none      &none
                                     &kp LCTRL  &kp LALT  &kp LGUI   &mo 1   &kp LG(SPACE)    &kp LSHIFT  &kp LALT  &kp LCTRL
            >;
        };

        layer_2 {
            display-name = "SYMBOL";
            bindings = <
                &kp EXCL    &kp AT      &kp HASH     &kp DLLR     &kp PRCNT                            &kp CARET      &kp AMPS     &kp STAR      &kp LPAR      &kp RPAR
                &kp N1      &kp N2      &kp N3       &kp N4       &kp N5                               &kp GRAVE      &kp MINUS    &kp EQUAL     &kp LBKT      &kp RBKT
                &kp N6      &kp N7      &kp N8       &kp N9       &kp N0      &kp PIPE    &kp BSLH     &kp TILDE    &kp UNDERSCORE &kp PLUS      &kp LBRC       &kp RBRC
                        &kp LCTRL    &kp LALT   &kp LGUI   &mo 3    &mo 2    &kp C_VOL_DN   &kp C_VOL_UP   &kp C_MUTE
            >;
        };

        layer_3 {
            display-name = "MOUSE & NUMPAD";
            bindings = <
                &none    &mkp MB4     &none     &mkp MB5     &none                                 &kp TAB         &kp KP_N7      &kp KP_N8      &kp KP_N9      &kp KP_MINUS
                &none    &mkp MB2     &mkp MB3  &mkp MB1     &none                                 &kp KP_ASTERISK &kp KP_N4     &kp KP_N5      &kp KP_N6      &kp KP_PLUS
                &none    &none        &none     &none        &none   &bt BT_SEL 1   &bootloader    &kp KP_SLASH    &kp KP_N1      &kp KP_N2      &kp KP_N3      &kp KP_ENTER
                        &kp LG(LS(N3))   &kp LG(LS(N4))   &kp LG(LS(N5))   &mo 3    &lt 3 SPACE     &kp KP_N0      &kp KP_DOT     &kp COMMA
            >;
        };


    };
};
